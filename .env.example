# ============================================================
# Session security
# ============================================================
# Random long string used to sign the session-id cookie.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# ============================================================
# Google OAuth (Gmail, read-only, delegated per-user)
# ============================================================
# From Google Cloud Console -> APIs & Services -> Credentials
# -> OAuth client ID -> Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ============================================================
# Microsoft identity platform (Graph, delegated per-user)
# ============================================================
# From Azure Portal -> App registrations -> your app
# -> Certificates & secrets / Authentication.
# Use "common" to allow both personal and work/school accounts,
# or a specific tenant GUID to restrict to one organization.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

# ============================================================
# NLLB Multilingual Translation Prototype (ValorProtects)
# ============================================================
# HuggingFace model ID for the NLLB translation prototype.
# The 600M distilled variant balances quality and CPU speed.
NLLB_MODEL_NAME=facebook/nllb-200-distilled-600M

# Local cache directory for downloaded model weights (~2.4 GB one-time download).
# Defaults to <project_root>/.cache/nllb if not set.
# NLLB_CACHE_DIR=.cache/nllb

# Maximum tokens fed to the tokenizer (hard truncation ceiling).
NLLB_MAX_INPUT_TOKENS=512

# Maximum new tokens the model may generate per call.
NLLB_MAX_OUTPUT_TOKENS=512

# Set to "false" to disable the translation layer entirely (no model load).
NLLB_ENABLED=true

# ============================================================
# SpamAssassin adapter (optional analysis stage)
# ============================================================
# SpamAssassin is an OPTIONAL, spam-oriented evidence stage in the
# email analysis pipeline. It is fully disabled by default: with
# SPAMASSASSIN_ENABLED unset/false, ValorProtects never invokes
# SpamAssassin (or Docker) and analyzes email normally, even when no
# SpamAssassin executable or container is installed/running.
#
# Set to "true" to enable the stage.
SPAMASSASSIN_ENABLED=false

# Command or path used to invoke SpamAssassin when the stage above is
# enabled. Only used if SPAMASSASSIN_ENABLED=true.
# Default (no Docker): SPAMASSASSIN_EXECUTABLE=spamassassin
#
# Docker-based local/dev example (requires a running
# valorprotects-spamassassin container - see project docs):
# SPAMASSASSIN_EXECUTABLE=docker.exe
# SPAMASSASSIN_ARGS=exec -i valorprotects-spamassassin spamassassin --test-mode --local --nocreate-prefs

# Maximum time (seconds) to let the SpamAssassin subprocess run before
# it is killed and treated as a timeout failure (analysis continues
# normally either way).
# SPAMASSASSIN_TIMEOUT_SECONDS=15
