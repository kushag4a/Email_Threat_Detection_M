%% scan-flow.mmd
%% CURRENT - traced from main.py::start_scan and scan_service.py::run_scan.
flowchart TD
    CLICK["User clicks 'Scan Inbox'<br/>(page size already selected: 5/10/20/50/100)"] --> REQ["POST /api/scan?provider=X&count=N"]

    REQ --> AUTHCHECK{"Valid session AND<br/>provider connected?"}
    AUTHCHECK -->|No| E401["HTTP 401"]
    AUTHCHECK -->|Yes| COLLECT

    subgraph COLLECT["Message ID collection (offloaded via run_in_executor -<br/>documented fix for a prior event-loop-blocking bug)"]
        direction TB
        C1["collect_message_ids()"]
        C2["provider.list_messages(page_size, page_token)<br/>loop until N ids collected or pages exhausted"]
        C1 --> C2
    end

    COLLECT --> CREATE["STORE.create_scan(session_id, requested=len(ids))<br/>-> scan_id generated"]

    CREATE --> RETURN["Route returns immediately:<br/>{scan_id, requested}"]

    CREATE --> BGTASK["asyncio.create_task(run_scan(...))<br/>fire-and-forget background task"]

    subgraph RUNSCAN["run_scan() - bounded concurrency (CURRENT, verified)"]
        direction TB
        SEM["asyncio.Semaphore(MAX_CONCURRENT_ANALYSES = 5)"]
        SEM --> W1["Worker: fetch message 1<br/>(run_in_executor)"]
        SEM --> W2["Worker: fetch message 2"]
        SEM --> W3["Worker: fetch message N<br/>(up to 5 concurrent at a time)"]

        W1 --> A1["analysis_service.analyze_email_safe()<br/>(run_in_executor)"]
        W2 --> A2["analyze_email_safe()"]
        W3 --> A3["analyze_email_safe()"]

        A1 --> R1{"Exception raised?"}
        R1 -->|Yes| F1["status: analysis_failed<br/>(does NOT abort other workers)"]
        R1 -->|No| S1["status: analyzed"]

        F1 --> APPEND["STORE.append_scan_result()<br/>STORE.save_result(session_id, provider.name, ...)<br/>STORE.update_scan(analyzed+=1 or failed+=1)"]
        S1 --> APPEND
    end

    BGTASK --> RUNSCAN
    APPEND --> DONE["All workers complete<br/>STORE.update_scan(status='complete')"]

    RETURN --> POLL["Frontend: pollScan()<br/>setInterval, every 700ms"]
    POLL --> GETSTATUS["GET /api/scan/{scan_id}"]
    GETSTATUS --> OWNCHECK{"STORE.get_scan(scan_id, session_id)<br/>owned by THIS session?"}
    OWNCHECK -->|No| E404["HTTP 404<br/>(also returned for a truly unknown scan_id -<br/>indistinguishable, by design, to avoid leaking<br/>scan existence across sessions)"]
    OWNCHECK -->|Yes| PROGRESS["{status, requested, analyzed, failed,<br/>skipped, progress: 'done/total', results}"]

    PROGRESS --> UPDATE["Frontend updates progress bar<br/>and merges results into the table"]
    UPDATE --> POLLCHECK{"status == 'complete'?"}
    POLLCHECK -->|No| POLL
    POLLCHECK -->|Yes| STOP["clearInterval - stop polling<br/>show final summary:<br/>Requested/Analyzed/Failed/Skipped"]

    DONE -.->|eventually reflected in| GETSTATUS
