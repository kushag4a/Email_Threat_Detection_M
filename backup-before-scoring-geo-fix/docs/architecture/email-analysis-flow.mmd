%% email-analysis-flow.mmd
%% CURRENT - traced directly from analysis_service.py::analyze_normalized_email,
%% top to bottom, exactly as executed.
flowchart TD
    IN["NormalizedEmail<br/>(from GmailProvider, MicrosoftGraphProvider,<br/>or analyze_eml_upload)"] --> STAGE1

    subgraph STAGE1["Stage 1: Attachment Security Engine (ALWAYS RUNS FIRST)"]
        direction TB
        A1["attachment_analysis.analyze_attachments()"]
    end

    STAGE1 --> STAGE2

    subgraph STAGE2["Stage 2: Header and Authentication Analysis (internal label: M1)"]
        direction TB
        B1["m1_adapter.prepare_m1_input(email)"]
        B2["m1_header_analyzer.analyze_email()<br/>-> spf, dkim, dmarc, origin_ip"]
        B3["_header_analysis(email)<br/>-> reply_to_mismatch, return_path_mismatch<br/>(compares real addresses via parseaddr,<br/>NOT raw header strings)"]
        B1 --> B2 --> B3
    end

    STAGE2 --> STAGE3

    subgraph STAGE3["Stage 3: AI Threat Classification (internal label: M2)"]
        direction TB
        C1["build_analysis_text(email)<br/>-> From/Reply-To/Return-Path/Subject/body as one string"]
        C2["classify_email(text, force_rule_based=<br/>attachment_result.has_high_severity)"]
        C3{"phishing_probability >= 0.40<br/>OR force_rule_based?"}
        C4["threat_classifier.detect_threats(text)<br/>(rule-based keyword scan)"]
        C5["Skip rule-based scan"]
        C1 --> C2 --> C3
        C3 -->|Yes| C4
        C3 -->|No| C5
    end

    STAGE3 --> STAGE4

    subgraph STAGE4["Stage 4: Threat Intelligence Engine (internal label: M3)"]
        direction TB
        D1["ips = [origin_ip] if present else []"]
        D2["phishtank_local.check_url() per URL<br/>(local JSON feed, lazy-loaded once)"]
        D3["spamhaus.check_ip() per IP<br/>(local CIDR list, lazy-loaded once)"]
        D4["local_engine.analyze_url() / analyze_ip()<br/>(pure heuristics, no feed needed)"]
        D1 --> D2
        D1 --> D3
        D1 --> D4
    end

    STAGE4 --> STAGE5

    subgraph STAGE5["Stage 5: IP Geolocation and Infrastructure (internal label: M4)"]
        direction TB
        E1["get_ip_geolocation(ip) per ip<br/>-> checks _GEO_CACHE (1hr TTL) first<br/>-> else HTTPS call to ipapi.co<br/>-> honest failure states, never fabricated"]
    end

    STAGE5 --> STAGE6

    subgraph STAGE6["Stage 6: Composite Risk Engine (CURRENT, canonical)"]
        direction TB
        F1["Additive scoring:<br/>AI probability + category bonuses<br/>+ SPF/DKIM/DMARC fail + mismatches<br/>+ PhishTank/Spamhaus/local-heuristic hits<br/>+ flagged attachments"]
        F2{"Any attachment has a<br/>high/medium YARA match?"}
        F3["score = max(score, 65)<br/>EXPLICIT FLOOR - documented policy,<br/>not YARA-match-equals-100"]
        F4["level = LOW/MEDIUM/HIGH/CRITICAL<br/>by score threshold"]
        F1 --> F2
        F2 -->|Yes| F3 --> F4
        F2 -->|No| F4
    end

    STAGE6 --> OUT["Final result dict<br/>message_id, provider, email, header_analysis,<br/>m1, m2, m3, m4, attachments, attachment_analysis,<br/>risk, evidence_sources, status, analyzed_at"]

    OUT --> WRAP{"Called via analyze_email_safe?"}
    WRAP -->|Exception raised anywhere above| FAIL["status: analysis_failed<br/>error: str(exc)<br/>batch scan continues with other messages"]
    WRAP -->|No exception| OUT
