%% attachment-yara-flow.mmd
%% CURRENT - traced directly from attachment_analysis.py.
%% YARA itself is PARTIAL/UNTESTED in this environment (yara-python
%% not installed) - the conditional STRUCTURE is CURRENT and verified.
flowchart TD
    START["Email parsed<br/>NormalizedEmail.attachments: list of AttachmentMeta<br/>(each may carry transient content_bytes)"] --> CHECK{"attachments list<br/>empty?"}

    CHECK -->|"YES (most emails)"| SKIP["analyze_attachments() returns IMMEDIATELY:<br/>scanned: false<br/>reason: 'No attachments'<br/>has_high_severity: false<br/><br/>file_type_detector and yara scanner<br/>are NEVER imported or called for this email<br/>(verified: 0.0s in timing log, no YARA overhead)"]

    CHECK -->|NO| LOOP["For EACH attachment:"]

    subgraph PERATTACHMENT["Per-attachment pipeline (CURRENT structure)"]
        direction TB
        S1["1. Categorize by extension<br/>executable_or_script / macro_enabled_document<br/>/ archive / document / image / unknown"]
        S2["2. Disguised double-extension check<br/>example: invoice.pdf.exe"]
        S3["3. Magic-byte detection<br/>file_type_detector.detect_file_type(content_bytes)<br/>PDF/PE/ELF/OLE2/ZIP/PNG/JPEG/GIF/RTF/PostScript signatures"]
        S4["4. Extension vs detected-type mismatch check<br/>check_extension_mismatch()"]
        S5["5. SHA-256<br/>already computed at parse time in email_parser.py"]
        S6["6. YARA scan<br/>yara scanner scan_bytes(content_bytes)<br/>PARTIAL/UNTESTED: yara-python not installed<br/>in this dev environment, always returns<br/>scanned:false with an honest reason here"]
        S1 --> S2 --> S3 --> S4 --> S5 --> S6
    end

    LOOP --> PERATTACHMENT

    PERATTACHMENT --> AGG["Aggregate:<br/>has_high_severity = True if ANY attachment has:<br/>executable/script ext, macro-enabled doc,<br/>disguised extension, type mismatch,<br/>or YARA high/medium match"]

    SKIP --> MERGE
    AGG --> MERGE["attachment_result returned to analysis_service.py"]

    MERGE --> COND1{"has_high_severity?"}
    COND1 -->|Yes| FORCE["AI Threat Classification stage:<br/>force_rule_based=True<br/>deeper keyword scan runs<br/>EVEN IF ML phishing probability is low<br/>ADDITIVE ONLY - never skips a stage"]
    COND1 -->|No| NORMAL["AI stage runs normal threshold check<br/>(>= 0.40 triggers deeper scan)"]

    FORCE --> RISKIN["Risk Engine input"]
    NORMAL --> RISKIN

    RISKIN --> COND2{"Any attachment YARA match<br/>severity high or medium?"}
    COND2 -->|Yes| FLOOR["score = max(score, 65)<br/>Cannot be diluted by a low AI/body score<br/>explicit, documented policy"]
    COND2 -->|No| NOFLOOR["Normal additive scoring only"]

    FLOOR --> FINAL["Final risk score/level/reasons"]
    NOFLOOR --> FINAL

    NOTE["IMPORTANT: YARA is a static, rule-based<br/>pattern-matching engine, NOT an ML model,<br/>NOT a guaranteed virus detector.<br/>'No matching rule' is reported as exactly that,<br/>never as 'file is safe'.<br/>Attachments are NEVER executed, opened, or<br/>rendered - only their bytes are inspected."]
