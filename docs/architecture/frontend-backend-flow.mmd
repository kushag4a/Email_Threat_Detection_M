%% frontend-backend-flow.mmd
%% CURRENT - every edge below verified by grepping static/app.js for
%% the exact endpoint path (see FRONTEND_FLOW.md's mapping table).
flowchart LR
    subgraph FRONTEND["static/app.js (single IIFE, no framework)"]
        LOAD["Page load<br/>refreshConnectionStatus()"]
        CONNBTN["Connect Gmail / Connect Microsoft buttons"]
        LOGOUTBTN["Logout button<br/>(top bar and Settings)"]
        REFRESHBTN["Refresh icon"]
        PAGESIZE["Page-size dropdown"]
        PREVNEXT["Previous / Next buttons"]
        SCANBTN["Scan Inbox button"]
        POLLFN["pollScan() - setInterval 700ms"]
        ROWCLICK["Click a scanned table row<br/>openDetailPanel()"]
        NAVSCANS["Sidebar: Scans<br/>loadScansView()"]
        NAVINTEL["Sidebar: Threat Intelligence<br/>loadIntelView()"]
        NAVCASES["Sidebar: Cases<br/>loadCasesView()"]
        NAVREPORTS["Sidebar: Reports<br/>loadReportsView()"]
        NAVSETTINGS["Sidebar: Settings<br/>loadSettingsView()"]
        THEMEBTN["Theme option click"]
        DROPZONE["Custom Email: drag/drop or browse"]
        ANALYZEBTN["Custom Email: Analyze All button"]
    end

    subgraph BACKEND["backend/app/main.py routes"]
        RSTATUS["GET /auth/google/status<br/>GET /auth/microsoft/status"]
        RLOGIN["GET /auth/google/login<br/>GET /auth/microsoft/login<br/>(full page navigation, not fetch)"]
        RLOGOUT["POST /auth/{provider}/logout"]
        REMAILS["GET /api/emails"]
        RSCAN["POST /api/scan"]
        RSCANGET["GET /api/scan/{scan_id}"]
        RSCANHIST["GET /api/scans/history<br/>GET /api/scans/bad-sources"]
        RINTEL["GET /api/threat-intel/summary"]
        RCASES["GET /api/cases"]
        RREPORTS["GET /api/reports/summary"]
        RBATCH["POST /api/analyze/batch"]
        NONE_1["(no backend call -<br/>pure client-side state)"]
    end

    LOAD --> RSTATUS
    CONNBTN --> RLOGIN
    LOGOUTBTN --> RLOGOUT
    REFRESHBTN --> REMAILS
    PAGESIZE --> REMAILS
    PREVNEXT --> REMAILS
    SCANBTN --> RSCAN
    RSCAN -.->|scan_id| POLLFN
    POLLFN --> RSCANGET
    ROWCLICK --> NONE_1
    NAVSCANS --> RSCANHIST
    NAVINTEL --> RINTEL
    NAVCASES --> RCASES
    NAVREPORTS --> RREPORTS
    NAVSETTINGS --> NONE_1
    THEMEBTN --> NONE_1
    DROPZONE --> NONE_1
    ANALYZEBTN --> RBATCH

    note1["Note: POST /api/analyze (singular) and<br/>GET /api/analysis/{provider}/{account_id}/{message_id}<br/>exist in main.py but have NO frontend caller<br/>(verified by grep - see API_FLOW.md)"]
